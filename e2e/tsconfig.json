{
  // E2E tests live outside `src` and are never emitted, so they get their own
  // project rather than widening the build's rootDir.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    // `page.evaluate()` callbacks are type-checked against the browser's
    // globals even though they are serialised, not run, on this side.
    "lib": ["es2023", "dom"]
  },
  "include": ["**/*.ts"]
}
