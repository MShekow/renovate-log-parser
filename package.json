{
  "name": "renovate-log-parser",
  "version": "0.1.0",
  "description": "A CLI that parses Renovate Bot debug logs to auto-detect issues, with an optional Nuxt-based web UI.",
  "type": "module",
  "bin": {
    "renovate-log-parser": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/.output"
  ],
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:cli",
    "build:cli": "tsc",
    "build:web": "npm run build --workspace web",
    "dev:cli": "tsx src/cli.ts",
    "dev:web": "npm run dev --workspace web",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "renovate",
    "logs",
    "parser",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/yargs": "17.0.35",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
